{
  "name": "@applyflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/main.js",
    "dev:watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@applyflow/ai": "workspace:*",
    "@applyflow/storage": "workspace:*",
    "@applyflow/config": "workspace:*",
    "@applyflow/domain": "workspace:*",
    "@applyflow/db": "workspace:*",
    "@applyflow/observability": "workspace:*",
    "@applyflow/schemas": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@applyflow/eslint-config": "workspace:*",
    "@applyflow/typescript-config": "workspace:*",
    "@nestjs/testing": "^11.0.11",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
