# ApplyFlow — Railway environment template
# Copy variables into each Railway service (or use shared project variables).
# Replace service references with your Railway service names.

# --- Runtime ---
NODE_ENV=production
APP_ENV=staging
# Use production + DEMO_AUTH_ENABLED=false for a hardened production deploy.

# --- Public URLs (https required) ---
API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}
WEB_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
ADMIN_URL=https://${{admin.RAILWAY_PUBLIC_DOMAIN}}

# --- Candidate / admin clients (set on web + admin at BUILD time) ---
NEXT_PUBLIC_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}/v1
NEXT_PUBLIC_DEMO_MODE=true

# --- Data stores (Railway plugins) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# --- Object storage (demo/staging: local path on volume; production: S3-compatible) ---
LOCAL_STORAGE_PATH=/data/uploads
# Optional S3-compatible (e.g. Cloudflare R2, AWS S3):
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=applyflow
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false

# --- Secrets (generate unique values — never use local defaults) ---
SESSION_SECRET=
JWT_ACCESS_SECRET=
ENCRYPTION_KEY=

# --- Demo / mock providers (staging demo) ---
DEMO_AUTH_ENABLED=true
MOCK_PROVIDERS_URL=https://${{mocks.RAILWAY_PUBLIC_DOMAIN}}
OIDC_ISSUER_URL=https://${{mocks.RAILWAY_PUBLIC_DOMAIN}}/oidc
OIDC_CLIENT_ID=applyflow-railway
OIDC_CLIENT_SECRET=
OIDC_WEB_REDIRECT_URI=https://${{api.RAILWAY_PUBLIC_DOMAIN}}/v1/auth/oidc/callback

# --- Feature flags (off until real credentials supplied) ---
LINKEDIN_OIDC_ENABLED=false
OPENAI_ENABLED=false
ANTHROPIC_ENABLED=false
STRIPE_ENABLED=false
RAZORPAY_ENABLED=false

# Railway injects PORT automatically — do not set API_PORT/WEB_PORT on platform.
